@page
@model RazorPage_test.Pages.Rewards.IndexModel
@{
    ViewData["Title"] = "Cửa Hàng Đổi Quà";
    Layout = "_UserLayout";
}

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="background: linear-gradient(to right, #2563eb, #7c3aed); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Khám Phá Cửa Hàng Quà Tặng</h1>
        <p class="text-secondary fs-5 mt-2">Đổi điểm thưởng để nhận những món quà độc quyền hấp dẫn</p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-5 bg-white p-4 rounded-4 shadow-sm border" style="border-color: #f8fafc;">
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <span style="font-size: 24px;">💎</span>
            </div>
            <div>
                <h6 class="text-muted mb-1 m-0">Điểm hiện tại của bạn</h6>
                <h3 class="m-0 fw-bold text-dark">@Model.UserPoints <small class="text-muted fs-6">điểm</small></h3>
            </div>
        </div>
        <a href="/Payment/Index" class="btn btn-primary rounded-pill px-4 py-2 fw-medium shadow-sm" style="transition: all 0.2s;"><i class="bi bi-plus-circle me-1"></i> Nạp thêm điểm</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success fw-bold">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
    }

    <div class="row">
        @if (!Model.Gifts.Any())
        {
            <div class="col-12 text-center text-muted my-5 p-5 bg-white rounded shadow-sm">
                <h4>Chưa có món quà nào!</h4>
                <p>Hiện tại cửa hàng quà tặng đang được chuẩn bị. Vui lòng quay lại sau nhé!</p>
            </div>
        }
        else
        {
            @foreach (var gift in Model.Gifts)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0" style="border-radius: 20px; overflow: hidden; background: linear-gradient(145deg, #ffffff, #f3f4f6); box-shadow: 0 10px 30px rgba(0,0,0,0.05); transition: transform 0.3s ease, box-shadow 0.3s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 15px 35px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 30px rgba(0,0,0,0.05)'">
                        <div class="card-body text-center p-5 d-flex flex-column">
                            <div class="mb-4 d-inline-block p-4 rounded-circle" style="background: linear-gradient(135deg, #e0e7ff 0%, #ede9fe 100%); width: 100px; height: 100px; display: flex; align-items: center; justify-content: center; margin: 0 auto; box-shadow: inset 0 2px 4px rgba(255,255,255,0.8), 0 4px 10px rgba(0,0,0,0.05);">
                                <span style="font-size: 48px;">@(string.IsNullOrEmpty(gift.Icon) ? "🎁" : gift.Icon)</span>
                            </div>
                            <h4 class="card-title fw-bold text-dark mb-2" style="font-family: 'Inter', sans-serif;">@gift.Name</h4>
                            <p class="card-text text-secondary small mb-4" style="min-height: 48px; line-height: 1.6;">@gift.Description</p>
                            
                            <div class="mt-auto">
                                <h3 class="fw-bold mb-4" style="color: #6366f1; background: linear-gradient(to right, #6366f1, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">@gift.PointsRequired <span style="font-size:18px">🪙</span></h3>
                                
                                @if (gift.Stock == 0)
                                {
                                    <button class="btn btn-secondary w-100 rounded-pill py-2 fw-medium" disabled>Hết hàng</button>
                                }
                                else if (Model.UserPoints < gift.PointsRequired)
                                {
                                    <button class="btn w-100 rounded-pill py-2 fw-medium" style="background-color: #f1f5f9; color: #94a3b8; border: none;" disabled>Chưa đủ điểm</button>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Exchange">
                                        <input type="hidden" name="giftId" value="@gift.Id" />
                                        <button type="submit" class="btn w-100 rounded-pill py-2 fw-bold text-white shadow-sm" style="background: linear-gradient(to right, #4f46e5, #8b5cf6); border: none; transition: 0.2s;" onmouseover="this.style.opacity='0.9'" onmouseout="this.style.opacity='1'" onclick="return confirm('Bạn có chắc muốn đổi @gift.Name với giá @gift.PointsRequired điểm?');">Đổi Quà Ngay</button>
                                    </form>
                                }
                                
                                <div class="mt-3">
                                    @if (gift.Stock > 0)
                                    {
                                        <span class="badge bg-light text-secondary rounded-pill fw-normal px-3 py-2">Còn lại: @gift.Stock</span>
                                    }
                                    else if (gift.Stock < 0)
                                    {
                                        <span class="badge bg-light text-secondary rounded-pill fw-normal px-3 py-2">Không giới hạn</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
