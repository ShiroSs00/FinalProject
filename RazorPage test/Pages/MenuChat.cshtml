@page
@model RazorPage_test.Pages.MenuChatModel
@{
    ViewData["Title"] = "AI Menu";
    Layout = "_UserLayout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/chat.css" />
}
<div style="padding:0; display:flex; flex-direction:column; flex:1;">
        @if (Model.Profile == null)
        {
            <div class="no-profile-banner">
                <span>⚠️</span>
                <div>
                    <strong>Chua co ho so suc khoe!</strong>
                    <p>Vui long <a href="/Profile">cap nhat ho so</a> truoc de AI tao thuc don phu hop voi ban.</p>
                </div>
            </div>
        }

        <div class="chat-layout">
            <!-- Profile sidebar -->
            <div class="chat-sidebar">
                <h3>📊 Chi so cua ban</h3>
                @if (Model.Profile != null)
                {
                    <div class="profile-chip">
                        <div class="chip-row"><span>BMI</span><strong>@Model.Profile.Bmi – @Model.Profile.BmiCategory</strong></div>
                        <div class="chip-row"><span>Calo/ngay</span><strong>@Model.Profile.Tdee kcal</strong></div>
                        <div class="chip-row"><span>Can nang</span><strong>@Model.Profile.Weight kg</strong></div>
                        <div class="chip-row"><span>Muc tieu</span>
                            <strong>@(Model.Profile.Goal == "GiamCan" ? "🔥 Giam can" : Model.Profile.Goal == "TangCo" ? "💪 Tang co" : "⚖️ Duy tri")</strong>
                        </div>
                    </div>

                    <form method="post" asp-page-handler="GenMenu">
                        @if (User.IsInRole("VIP") || User.IsInRole("Admin"))
                        {
                            <button type="submit" class="btn-gen-menu" @(Model.IsLoading ? "disabled" : "")>
                                @if (Model.IsLoading) { <span class="spinner"></span> } else { <span>✨</span> }
                                Gen Menu Hom Nay
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn-gen-menu" style="background:#cbd5e1; cursor:not-allowed;" title="Tính năng VIP">
                                <span>🔒</span> Gen Menu Hom Nay (VIP)
                            </button>
                        }
                    </form>
                }
                else
                {
                    <a href="/Profile" class="btn-gen-menu">👤 Cap nhat ho so</a>
                }

                <div class="quick-prompts" @(!User.IsInRole("VIP") && !User.IsInRole("Admin") ? "style='opacity:0.5; pointer-events:none;'" : "")>
                    <p>Goi y nhanh:</p>
                    <button class="quick-btn" onclick="setPrompt('Toi co the an gi vao bua sang?')">🌅 Bua sang</button>
                    <button class="quick-btn" onclick="setPrompt('Mon an nhe cho bua toi?')">🌙 Bua toi nhe</button>
                    <button class="quick-btn" onclick="setPrompt('Thuc pham nao giup tang co tot nhat?')">💪 Tang co</button>
                    <button class="quick-btn" onclick="setPrompt('Do an chay phu hop voi chi so cua toi?')">🥦 Mon chay</button>
                </div>
            </div>

            <!-- Chat area -->
            <div class="chat-area">
                @if (User.IsInRole("VIP") || User.IsInRole("Admin"))
                {
                    <div class="chat-messages" id="chatMessages">
                        @if (!Model.Messages.Any())
                        {
                            <div class="chat-welcome">
                                <div class="welcome-icon">🤖</div>
                                <h3>Xin chao! Toi la NutriBot 👋</h3>
                                <p>Toi se giup ban len thuc don dinh duong theo chi so suc khoe cua ban.<br/>
                                   Nhan <strong>"Gen Menu Hom Nay"</strong> hoac tu van truc tiep o o chat ben duoi!</p>
                            </div>
                        }
                        else
                        {
                            foreach (var msg in Model.Messages)
                            {
                                <div class="msg @(msg.Role == "user" ? "msg-user" : "msg-bot")">
                                    @if (msg.Role == "model")
                                    {
                                        <div class="msg-avatar">🤖</div>
                                    }
                                    <div class="msg-bubble">
                                        <div class="msg-content">@Html.Raw(msg.Content.Replace("\n", "<br/>"))</div>
                                        <div class="msg-time">@msg.Timestamp.ToString("HH:mm")</div>
                                    </div>
                                    @if (msg.Role == "user")
                                    {
                                        <div class="msg-avatar user-av">@(User.Identity?.Name?[0].ToString().ToUpper() ?? "U")</div>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <!-- Input area -->
                    <div class="chat-input-area">
                        <form method="post" asp-page-handler="Send" class="chat-form">
                            <textarea id="chatInput" name="UserMessage" class="chat-input"
                                      placeholder="Hoi ve thuc don, dinh duong, mon an..." rows="1"
                                      onkeydown="handleEnter(event)"></textarea>
                            <button type="submit" class="btn-send">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                                </svg>
                            </button>
                        </form>
                        <form method="post" asp-page-handler="ClearChat" style="margin:0">
                            <button type="submit" class="btn-clear">🗑️ Xoa lich su</button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="chat-welcome" style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; text-align:center;">
                        <span style="font-size: 64px; margin-bottom: 20px;">💎</span>
                        <h3 style="font-size: 24px; color: #1e293b; margin-bottom: 12px;">Độc Quyền AI Menu</h3>
                        <p style="color: #64748b; margin-bottom: 24px; max-width: 400px; line-height: 1.6;">Tính năng tự động lên thực đơn hàng ngày bằng trí tuệ nhân tạo (AI) yêu cầu tài khoản VIP. Hãy nâng cấp để sử dụng dịch vụ thông minh này!</p>
                        <a href="/Payment/Index" class="btn-gen-menu" style="width: auto; padding: 12px 32px; font-size: 16px;">Nâng cấp VIP ngay</a>
                    </div>
                }
            </div>
        </div>
</div>

@section Scripts {
    <script>
        // Scroll to bottom on load
        const chatMessages = document.getElementById('chatMessages');
        if (chatMessages) chatMessages.scrollTop = chatMessages.scrollHeight;

        function setPrompt(text) {
            document.getElementById('chatInput').value = text;
            document.getElementById('chatInput').focus();
        }

        function handleEnter(e) {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                e.target.closest('form').submit();
            }
        }

        // Auto-resize textarea
        const ta = document.getElementById('chatInput');
        if(ta) ta.addEventListener('input', () => {
            ta.style.height = 'auto';
            ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
        });
    </script>
}
