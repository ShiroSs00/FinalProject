@page
@model RazorPage_test.Pages.RegisterModel
@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký – NutriFood</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body class="auth-body">
    <div class="auth-wrapper">
        <!-- Left panel -->
        <div class="auth-banner">
            <div class="banner-content">
                <div class="logo">🥗</div>
                <h1>NutriFood</h1>
                <p>Bắt đầu hành trình sống khỏe của bạn ngay hôm nay!</p>
                <ul class="feature-list">
                    <li>✅ Miễn phí hoàn toàn</li>
                    <li>✅ Cộng đồng hơn 10,000+ thành viên</li>
                    <li>✅ Chuyên gia dinh dưỡng đồng hành</li>
                </ul>
            </div>
            <div class="floating-cards">
                <div class="fc fc1">🍊 Cam tươi</div>
                <div class="fc fc2">🫐 Việt quất</div>
                <div class="fc fc3">🥕 Cà rốt</div>
            </div>
        </div>

        <!-- Right panel – Register Form -->
        <div class="auth-panel">
            <div class="auth-card">
                <h2>Tạo tài khoản mới</h2>
                <p class="subtitle">Điền thông tin để bắt đầu hành trình khỏe mạnh</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-error">⚠️ @Model.ErrorMessage</div>
                }

                <form method="post" class="auth-form">
                    <div class="form-group">
                        <label for="fullname">Họ và tên</label>
                        <div class="input-wrapper">
                            <span class="input-icon">🙍</span>
                            <input id="fullname" name="FullName" type="text" placeholder="Nguyễn Văn A" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <div class="input-wrapper">
                            <span class="input-icon">📧</span>
                            <input id="email" name="Email" type="email" placeholder="email@example.com" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="username">Tên đăng nhập</label>
                        <div class="input-wrapper">
                            <span class="input-icon">👤</span>
                            <input id="username" name="Username" type="text" placeholder="Nhập tên đăng nhập" required autocomplete="username" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="password">Mật khẩu</label>
                        <div class="input-wrapper">
                            <span class="input-icon">🔒</span>
                            <input id="password" name="Password" type="password" placeholder="Ít nhất 6 ký tự" required autocomplete="new-password" />
                        </div>
                    </div>
                    <button type="submit" class="btn-primary">Đăng ký</button>
                </form>

                <p class="auth-switch">
                    Đã có tài khoản? <a href="/Login">Đăng nhập</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>
