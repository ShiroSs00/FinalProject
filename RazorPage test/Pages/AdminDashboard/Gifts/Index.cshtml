@page
@model RazorPage_test.Pages.AdminDashboard.Gifts.IndexModel
@{
    ViewData["Title"] = "Quản lý Quà Tặng";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-gift text-primary"></i> Quản lý Quà Tặng</h2>
    <a href="/AdminDashboard/Gifts/Create" class="btn btn-primary fw-bold px-4 rounded-pill">+ Thêm Quà Mới</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success fs-6">✅ @TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0 border-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-4 border-0 text-muted fw-medium">Quà tặng</th>
                    <th class="border-0 text-muted fw-medium">Điểm đổi (🪙)</th>
                    <th class="border-0 text-muted fw-medium">Số lượng</th>
                    <th class="border-0 text-muted fw-medium">Trạng thái</th>
                    <th class="border-0 text-muted fw-medium text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (!Model.Gifts.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">Chưa có phần quà nào. Hãy tạo mới!</td>
                    </tr>
                }
                else
                {
                    @foreach (var gift in Model.Gifts)
                    {
                        <tr>
                            <td class="ps-4 border-light">
                                <div class="d-flex align-items-center">
                                    <div class="fs-2 me-3">@(string.IsNullOrEmpty(gift.Icon) ? "🎁" : gift.Icon)</div>
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@gift.Name</div>
                                        <small class="text-muted text-truncate d-inline-block" style="max-width:250px;">@gift.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-bold text-danger border-light fs-5">@gift.PointsRequired</td>
                            <td class="border-light">@(gift.Stock < 0 ? "Vô hạn" : gift.Stock.ToString())</td>
                            <td class="border-light">
                                @if (gift.IsActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3">Đang mở</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">Tạm ẩn</span>
                                }
                            </td>
                            <td class="text-end pe-4 border-light">
                                <a href="/AdminDashboard/Gifts/Edit?id=@gift.Id" class="btn btn-sm btn-outline-warning rounded-pill px-3">Sửa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
