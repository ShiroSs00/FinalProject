@page
@model RazorPage_test.Pages.AdminDashboard.Gifts.EditModel
@{
    ViewData["Title"] = "Sửa Quà Tặng";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm rounded-4 mx-auto mt-4" style="max-width: 600px;">
    <div class="card-body p-4 p-md-5">
        <h3 class="fw-bold mb-4 text-warning">✏️ Sửa Quà Tặng</h3>
        
        <form method="post">
            <input type="hidden" asp-for="Gift.Id" />
            <input type="hidden" asp-for="Gift.CreatedAt" />
            
            <div class="mb-3">
                <label class="form-label fw-semibold">Tên Quà Tặng</label>
                <input type="text" asp-for="Gift.Name" class="form-control" required />
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-semibold">Icon / Hình Ảnh (URL, Emoji)</label>
                <input type="text" asp-for="Gift.Icon" class="form-control" />
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label fw-semibold">Điểm yêu cầu (🪙)</label>
                    <input type="number" asp-for="Gift.PointsRequired" class="form-control" min="0" required />
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold">Số lượng tồn kho</label>
                    <input type="number" asp-for="Gift.Stock" class="form-control" required />
                    <small class="text-muted d-block mt-1">Nhập -1 nếu số lượng không giới hạn</small>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Mô tả chi tiết</label>
                <textarea asp-for="Gift.Description" class="form-control" rows="3"></textarea>
            </div>
            
            <div class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" asp-for="Gift.IsActive">
                <label class="form-check-label" for="Gift_IsActive">Đang phát hành (Kích hoạt)</label>
            </div>

            @if (!ModelState.IsValid)
            {
                <div class="text-danger mb-3" asp-validation-summary="All"></div>
            }

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn btn-warning flex-grow-1 fw-bold text-white rounded-pill">Cập Nhật</button>
                <a href="/AdminDashboard/Gifts" class="btn btn-light text-muted fw-bold rounded-pill px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>
