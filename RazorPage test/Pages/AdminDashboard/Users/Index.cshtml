@page
@model RazorPage_test.Pages.AdminDashboard.UsersModel
@{
    ViewData["Title"] = "Quản lý Người Dùng";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0"><i class="bi bi-people text-primary"></i> Danh sách Người Dùng</h2>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 border-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 fw-medium text-muted border-0">ID</th>
                        <th class="fw-medium text-muted border-0">Người dùng</th>
                        <th class="fw-medium text-muted border-0">Vai trò</th>
                        <th class="fw-medium text-muted border-0">Điểm (🪙)</th>
                        <th class="fw-medium text-muted border-0">Đăng ký</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4 text-muted border-light">#@user.Id</td>
                            <td class="border-light">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex justify-content-center align-items-center me-3 text-primary fw-bold flex-shrink-0" style="width:40px; height:40px; font-size: 14px;">
                                        @((user.FullName?.Length > 0 ? user.FullName[0].ToString().ToUpper() : "U"))
                                    </div>
                                    <div>
                                        <span class="fw-semibold d-block text-dark">@user.FullName</span> 
                                        <small class="text-muted d-block">@user.Email | @user.Username</small>
                                    </div>
                                </div>
                            </td>
                            <td class="border-light">
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger rounded-pill px-3">Admin</span>
                                }
                                else if (user.Role == "VIP")
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3">VIP</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-3">User</span>
                                }
                            </td>
                            <td class="fw-bold text-success border-light fs-5">@user.Points</td>
                            <td class="text-muted border-light"><small>@user.CreatedAt.ToString("dd/MM/yyyy")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
