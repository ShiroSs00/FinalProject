@page
@model RazorPage_test.Pages.AdminDashboard.IndexModel
@{
    ViewData["Title"] = "Quản lý Thực Đơn";
    Layout = "_AdminLayout";
}

<style>
    .admin-container { background: #fff; padding: 32px; border-radius: 16px; box-shadow: 0 4px 16px rgba(0,0,0,0.05); }
    .header-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    h1 { margin: 0; font-weight: 800; font-size: 24px; }
    .btn { padding: 10px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; display: inline-block; border: none; transition: 0.2s; }
    .btn-primary { background: #3b82f6; color: white; }
    .btn-primary:hover { background: #2563eb; }
    .btn-success { background: #16a34a; color: white; display: flex; align-items: center; gap: 8px; }
    .btn-success:hover { background: #15803d; }
    .btn-edit { background: #f59e0b; color: white; padding: 6px 12px; font-size: 12px; }
    .btn-danger { background: #ef4444; color: white; padding: 6px 12px; font-size: 12px; }
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    th, td { text-align: left; padding: 14px 12px; border-bottom: 1px solid #e2e8f0; }
    th { background: #f8fafc; font-weight: 600; color: #475569; font-size: 13px; text-transform: uppercase; }
    .alert { padding: 12px; border-radius: 8px; margin-bottom: 20px; font-weight: 600; }
    .alert-success { background: #dcfce7; color: #166534; }
    .icon-circle { display: inline-flex; justify-content: center; align-items: center; width: 36px; height: 36px; background: #f1f5f9; border-radius: 50%; font-size: 18px; }
</style>

<div class="admin-container">
    <div class="header-row">
        <h1>🍳 Quản lý Thực đơn Đề xuất</h1>
        <div style="display:flex; gap:12px;">
            @if (Model.CanCreate)
            {
                <a href="/AdminDashboard/Meals/Create" class="btn btn-primary">+ Thêm món mới</a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }

    @if (!Model.Meals.Any())
    {
        <p style="text-align:center; color:#64748b; padding: 40px 0;">Chưa có thực đơn nào. Hãy thêm bữa Sáng, Trưa, Tối!</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Bữa</th>
                    <th>Món ăn</th>
                    <th>Dinh dưỡng</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var meal in Model.Meals.OrderBy(m => m.MealType == "Breakfast" ? 1 : m.MealType == "Lunch" ? 2 : 3))
                {
                    <tr>
                        <td>
                            <strong>@(meal.MealType == "Breakfast" ? "Sáng" : meal.MealType == "Lunch" ? "Trưa" : "Tối")</strong>
                        </td>
                        <td>
                            <div style="display:flex; align-items:center; gap:12px;">
                                <span class="icon-circle">@meal.Icon</span>
                                <div>
                                    <div style="font-weight:600; color:#0f172a;">@meal.Name</div>
                                    <div style="font-size:12px; color:#64748b; max-width:300px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@meal.Description</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div style="font-size:13px; color:#475569;">🔥 @meal.Calories kcal</div>
                            <div style="font-size:13px; color:#475569;">⏱ @meal.Minutes phút</div>
                        </td>
                        <td>
                            <a href="/AdminDashboard/Meals/Edit?id=@meal.Id" class="btn btn-edit">Sửa</a>
                            <form method="post" asp-page-handler="Delete" style="display:inline;">
                                <input type="hidden" name="id" value="@meal.Id" />
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Xóa bữa @meal.MealType?');">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
